{
  "name": "@aiwork/dsh-smart-edit",
  "version": "1.0.0",
  "description": "DSH bundle: Smart Edit interactive book workshop (host tools + sidebar panel)",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./skill/SKILL.md": "./skill/SKILL.md"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "skill",
    "catalog",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node tests/host.smoke.mjs && node tests/client.smoke.mjs && node tests/editor.dom.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin",
        "win32",
        "linux"
      ]
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0",
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webcatevan/aiwork-editor-harness.git",
    "directory": "packages/bundle"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
